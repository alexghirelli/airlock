#!/usr/bin/env bash
# pi-team — start a lead Pi agent plus named specialist Pi agents in Herdr panes.
#
# Usage (run inside a Herdr pane, from the project directory):
#   pi-team up [role ...]   split panes, start specialists, then turn this pane into the lead
#   pi-team up --solo       just the lead, no specialists
#   pi-team up --focus [..] specialists go to a separate "crew" tab; you only see the lead
#   pi-team spawn <role>    start one more specialist (the lead uses this on demand)
#   pi-team down            close the specialist panes started for this directory
#   pi-team status          list Herdr agents
#   pi-team roles           list available roles
#
# Config:   $PI_TEAM_DIR/models.env   (generated by airlock from [team.models]/[team.thinking])
# Profiles: $PI_TEAM_PROFILES/<role>.md (default $PI_TEAM_DIR/profiles)
# An empty MODEL_<ROLE> means "Pi's default model".
# shellcheck disable=SC2034,SC2016  # MODEL_*/THINK_* read via ${!var}; backticks are literal markdown
set -euo pipefail

TEAM_DIR="${PI_TEAM_DIR:-$HOME/.pi-team}"
PROFILES="${PI_TEAM_PROFILES:-$TEAM_DIR/profiles}"
HERDR="${HERDR_BIN:-herdr}"
PI="${PI_BIN:-pi}"

die() { printf 'pi-team: %s\n' "$*" >&2; exit 1; }
log() { printf 'pi-team: %s\n' "$*" >&2; }

# ---------- config ----------
# Defaults (overridden by models.env). No model ids are hard-coded.
MODEL_LEAD="";     THINK_LEAD="high"
DEFAULT_ROLES="reviewer tester scout scribe"
LEAD_WIDTH="0.55"
READONLY_TOOLS="read,grep,find,ls,bash,write"
READONLY_ROLES="reviewer scout"
# shellcheck source=/dev/null
[[ -f "$TEAM_DIR/models.env" ]] && source "$TEAM_DIR/models.env"

upper() { printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'; }
model_for() { local v; v="MODEL_$(upper "$1")"; printf '%s' "${!v:-$MODEL_LEAD}"; }
think_for() { local v; v="THINK_$(upper "$1")"; printf '%s' "${!v:-high}"; }
is_readonly() { [[ " $READONLY_ROLES " == *" $1 "* ]]; }
describe_model() { printf '%s' "${1:-default model}"; }

# Herdr agent names must match [a-z][a-z0-9_-]{0,31}; we use <prefix>-<role>.
make_prefix() {
  local p
  p="$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"
  [[ "$p" =~ ^[a-z] ]] || p="p${p}"
  printf '%s' "${p:0:20}"
}

PREFIX="${PI_TEAM_PREFIX:-$(make_prefix)}"
RUN_DIR="$TEAM_DIR/run/$PREFIX"
REPORTS="$RUN_DIR/reports"
PANES_FILE="$RUN_DIR/panes"
MODE_FILE="$RUN_DIR/mode"
LEAD_PANE_FILE="$RUN_DIR/lead-pane"

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found in PATH"; }

pane_id_from_json() {
  # pane split → .result.pane.pane_id
  jq -er '.result.pane.pane_id // empty'
}

split_pane() { # split_pane <pane> <right|down> <ratio>  → prints new pane id
  "$HERDR" pane split --pane "$1" --direction "$2" --ratio "$3" \
    --cwd "$PWD" --no-focus | pane_id_from_json \
    || die "failed to split pane $1"
}

start_specialist() { # start_specialist <role> <pane>
  local role="$1" pane="$2" name="$PREFIX-$1"
  local profile="$PROFILES/$role.md" model
  model="$(model_for "$role")"
  local -a args=(--thinking "$(think_for "$role")" --append-system-prompt "$profile")
  if [[ -n "$model" ]]; then args=(--model "$model" "${args[@]}"); fi
  if is_readonly "$role"; then args+=(--tools "$READONLY_TOOLS"); fi
  log "starting $name ($(describe_model "$model"), thinking $(think_for "$role")) in $pane"
  "$HERDR" agent start "$name" --kind pi --pane "$pane" --timeout 120000 -- "${args[@]}" >/dev/null \
    || die "failed to start $name (check: herdr agent explain --file … / herdr integration status)"
}

write_lead_prompt() { # write_lead_prompt <role ...>
  local out="$RUN_DIR/lead.md" role
  {
    cat "$PROFILES/lead.md"
    printf '\n## Team roster\n\n'
    printf 'Working directory: `%s`\n' "$PWD"
    printf 'Reports directory: `%s` (tell each teammate the exact file to write, e.g. `%s/<role>-<topic>.md`)\n\n' "$REPORTS" "$REPORTS"
    printf 'Running now:\n'
    if (($# == 0)); then printf -- '- (none)\n'; fi
    for role in "$@"; do
      printf -- '- `%s` — %s (%s)\n' "$PREFIX-$role" "$role" "$(describe_model "$(model_for "$role")")"
    done
    printf '\nAvailable on demand (start with `pi-team spawn <role>`, it prints the agent name):\n'
    local f r
    for f in "$PROFILES"/*.md; do
      r="$(basename "$f" .md)"
      [[ "$r" == lead || " $* " == *" $r "* ]] && continue
      printf -- '- %s\n' "$r"
    done
  } >"$out"
  printf '%s' "$out"
}

pane_alive() { "$HERDR" pane get "$1" >/dev/null 2>&1; }

# Create a pane for the next specialist and print its id.
# First helper: split the lead's pane to the right (and, in focus mode, move it
# to its own "crew" tab). Next helpers: split the last helper's pane downwards.
new_helper_pane() { # new_helper_pane <ratio-for-down-split>
  local last="" p
  [[ -s "$PANES_FILE" ]] && last="$(tail -n 1 "$PANES_FILE")"
  if [[ -n "$last" ]] && pane_alive "$last"; then
    split_pane "$last" down "$1"
    return
  fi
  local lead_pane
  lead_pane="$(cat "$LEAD_PANE_FILE" 2>/dev/null || printf '%s' "${HERDR_PANE_ID:-}")"
  [[ -n "$lead_pane" ]] || die "cannot find the lead's pane"
  p="$(split_pane "$lead_pane" right "$(awk -v w="$LEAD_WIDTH" 'BEGIN{printf "%.3f", 1-w}')")"
  if [[ "$(cat "$MODE_FILE" 2>/dev/null)" == focus ]]; then
    "$HERDR" pane move "$p" --new-tab --label "$PREFIX-crew" --no-focus >/dev/null \
      || log "warning: could not move $p to a separate tab; it stays next to the lead"
  fi
  printf '%s' "$p"
}

cmd_roles() {
  local f
  for f in "$PROFILES"/*.md; do
    [[ "$(basename "$f" .md)" == lead ]] && continue
    printf '%s\n' "$(basename "$f" .md)"
  done
}

cmd_up() {
  need "$HERDR"; need "$PI"; need jq
  [[ -n "${HERDR_PANE_ID:-}" ]] || die "run this inside a Herdr pane (HERDR_PANE_ID is not set)"
  [[ -f "$PROFILES/lead.md" ]] || die "missing $PROFILES/lead.md"

  local mode=split solo=0
  local -a roles=()
  while (($# > 0)); do
    case "$1" in
      --focus) mode=focus ;;
      --solo)  solo=1 ;;
      -*)      die "unknown option '$1'" ;;
      *)       roles+=("$1") ;;
    esac
    shift
  done
  if ((solo == 0 && ${#roles[@]} == 0)); then read -r -a roles <<<"$DEFAULT_ROLES"; fi

  local role
  for role in ${roles[@]+"${roles[@]}"}; do
    [[ -f "$PROFILES/$role.md" ]] || die "unknown role '$role' (no $PROFILES/$role.md)"
    if "$HERDR" agent get "$PREFIX-$role" >/dev/null 2>&1; then
      die "agent $PREFIX-$role is already running; use 'pi-team down' first or set PI_TEAM_PREFIX"
    fi
  done

  mkdir -p "$REPORTS"
  : >"$PANES_FILE"
  printf '%s' "$mode" >"$MODE_FILE"
  printf '%s' "$HERDR_PANE_ID" >"$LEAD_PANE_FILE"

  # Equal heights: helper i (i>=1) takes (n-i)/(n-i+1) of the previous helper's pane.
  local n=${#roles[@]} i pane ratio
  for ((i = 0; i < n; i++)); do
    ratio="$(awk -v a="$((n - i))" -v b="$((n - i + 1))" 'BEGIN{printf "%.3f", a/b}')"
    pane="$(new_helper_pane "$ratio")"
    printf '%s\n' "$pane" >>"$PANES_FILE"
    start_specialist "${roles[i]}" "$pane"
  done

  local lead_prompt
  lead_prompt="$(write_lead_prompt ${roles[@]+"${roles[@]}"})"
  log "team up ($mode): ${roles[*]:-(none)}; reports in $REPORTS"
  log "starting lead ($(describe_model "$MODEL_LEAD"), thinking $THINK_LEAD) in this pane"
  export PI_TEAM_PREFIX="$PREFIX" PI_TEAM_CWD="$PWD"
  local -a lead_args=(--thinking "$THINK_LEAD" --append-system-prompt "$lead_prompt")
  if [[ -n "$MODEL_LEAD" ]]; then lead_args=(--model "$MODEL_LEAD" "${lead_args[@]}"); fi
  exec "$PI" "${lead_args[@]}"
}

cmd_spawn() {
  need "$HERDR"; need jq
  local role="${1:-}"
  [[ -n "$role" ]] || die "usage: pi-team spawn <role>"
  [[ -f "$PROFILES/$role.md" && "$role" != lead ]] || die "unknown role '$role'"
  [[ -f "$LEAD_PANE_FILE" ]] || die "no team running for '$PREFIX' (start it with 'pi-team up')"
  [[ -n "${PI_TEAM_CWD:-}" ]] && cd "$PI_TEAM_CWD"
  if "$HERDR" agent get "$PREFIX-$role" >/dev/null 2>&1; then
    printf '%s\n' "$PREFIX-$role"; return   # already running: nothing to do
  fi
  local pane
  pane="$(new_helper_pane 0.5)"
  printf '%s\n' "$pane" >>"$PANES_FILE"
  start_specialist "$role" "$pane"
  printf '%s\n' "$PREFIX-$role"
}

cmd_down() {
  need "$HERDR"
  [[ -f "$PANES_FILE" ]] || die "no running team recorded for '$PREFIX'"
  local pane
  while read -r pane; do
    [[ -n "$pane" ]] || continue
    log "closing $pane"
    "$HERDR" pane close "$pane" >/dev/null 2>&1 || log "  (already gone)"
  done <"$PANES_FILE"
  rm -f "$PANES_FILE" "$MODE_FILE" "$LEAD_PANE_FILE"
}

cmd_status() { need "$HERDR"; "$HERDR" agent list; }

case "${1:-up}" in
  up)      shift || true; cmd_up "$@" ;;
  spawn)   shift; cmd_spawn "$@" ;;
  down)    cmd_down ;;
  status)  cmd_status ;;
  roles)   cmd_roles ;;
  -h|--help|help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)       die "unknown command '$1' (try: up, spawn, down, status, roles)" ;;
esac
